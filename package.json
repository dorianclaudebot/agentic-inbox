{
  "name": "agentic-inbox",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy --keep-vars",
    "dev": "react-router dev",
    "preview": "npm run build && vite preview",
    "typecheck": "npm run cf-typegen && react-router typegen && tsc -b",
    "android:icons": "node scripts/android/generate-icons.mjs",
    "android:apk": "node scripts/android/build-apk.mjs",
    "android:sideload": "node scripts/android/sideload.mjs"
  },
  "dependencies": {
